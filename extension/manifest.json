{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "0.6.39",
  "description": "__MSG_appDescription__",
  "key": "",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://127.0.0.1:47321/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FrameDepth",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "toggle-3d": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "__MSG_commandToggle__" },
    "strength-up": { "suggested_key": { "default": "Alt+Shift+Up" }, "description": "__MSG_commandStrengthUp__" },
    "strength-down": { "suggested_key": { "default": "Alt+Shift+Down" }, "description": "__MSG_commandStrengthDown__" },
    "popout-up": { "description": "__MSG_commandPopoutUp__" },
    "popout-down": { "description": "__MSG_commandPopoutDown__" }
  }
}
